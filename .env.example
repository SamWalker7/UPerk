# --- Client portal (/portal) ---
# Shared login. No signup/reset. Two passwords: one for clients, one for PMs.
PORTAL_USER=client
PORTAL_PASSWORD=change-me-client
PORTAL_PM_PASSWORD=change-me-pm
# Used to sign the session cookie. Generate: openssl rand -base64 32
PORTAL_SESSION_SECRET=change-me-long-random-string

# When the backend from docs/portal-api-contract.md exists, set this and update
# src/lib/portal/data.ts. Leave unset to read src/portal-data/portal.json.
# PORTAL_API_URL=https://api.example.com
