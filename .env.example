# --- Client portal (/portal) ---
# Backend API base URL (see docs/portal-api-contract.md and <url>/api-docs/#/).
# The portal signs in against POST /api/portal/auth/login on this API — there
# are no portal-side passwords anymore.
PORTAL_API_URL=https://example.execute-api.us-east-1.amazonaws.com/prod

# Used to sign the portal's own session cookie (wraps the backend's bearer
# token). Generate: openssl rand -base64 32
PORTAL_SESSION_SECRET=change-me-long-random-string
